{
  "entities": {
    "userProfile": {
      "title": "User Profile",
      "description": "User account info and Socratic learning vector",
      "type": "document",
      "path": "users/{userId}",
      "fields": {
        "uid": { "type": "string", "description": "Firebase Auth user ID" },
        "name": { "type": "string", "description": "Display name" },
        "email": { "type": "string", "description": "User email address" },
        "avatar": { "type": "string", "description": "Profile picture URL" },
        "plan": { "type": "string", "description": "Subscribed plan" },
        "diagnosticScore": { "type": "number", "description": "Placement diagnostic total score" },
        "confidence": { "type": "number", "description": "User confidence level percentage" },
        "cognitiveLoad": { "type": "string", "description": "Cognitive load status" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
      }
    },
    "userCurriculumProgress": {
      "title": "Curriculum Unit Progress",
      "description": "Progress per curriculum unit",
      "type": "document",
      "path": "users/{userId}/units/{unitId}",
      "fields": {
        "unitId": { "type": "string", "description": "Unit ID code" },
        "progress": { "type": "number", "description": "Progress percentage" },
        "updatedAt": { "type": "string", "description": "ISO timestamp" }
      }
    },
    "userSynthesizerPath": {
      "title": "Synthesized Course Path",
      "description": "Custom Socratic courses generated by the user",
      "type": "document",
      "path": "users/{userId}/synthesizedPaths/{pathId}",
      "fields": {
        "id": { "type": "string", "description": "Unique path ID" },
        "title": { "type": "string", "description": "Course title" },
        "phase": { "type": "string", "description": "Target developmental phase" },
        "axioms": { "type": "array", "description": "Primitive axioms" },
        "modules": { "type": "array", "description": "Course modules" },
        "createdAt": { "type": "string", "description": "ISO timestamp" }
      }
    },
    "chatHistory": {
      "title": "Chat History",
      "description": "Persistent conversation messages with the voice assistant",
      "type": "document",
      "path": "users/{userId}/chatHistory/{messageId}",
      "fields": {
        "id": { "type": "string", "description": "Message ID" },
        "sender": { "type": "string", "description": "Sender role (user or lumen)" },
        "text": { "type": "string", "description": "Message text" },
        "timestamp": { "type": "string", "description": "Timestamp string" },
        "actionTaken": { "type": "string", "description": "Optional action taken" }
      }
    }
  }
}
